APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# Comma-separated list of allowed browser origins.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
S3_BUCKET=verix-documents

# Bedrock. In regions such as ap-south-1, replace these with the
# cross-region inference profile IDs shown in your Bedrock console (e.g.
# apac.amazon.nova-pro-v1:0) — the bare foundation-model IDs below are
# often not directly invokable there.
BEDROCK_MAIN_MODEL=amazon.nova-pro-v1:0
BEDROCK_FAST_MODEL=amazon.nova-lite-v1:0
BEDROCK_MICRO_MODEL=amazon.nova-micro-v1:0
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

MAX_SOURCE_CHARS=50000
MAX_OUTPUT_TOKENS=5000
MAX_URL_FETCH_BYTES=2000000
